# ══════════════════════════════════════════════════════════════
# AI ERP Assistant — Environment Variables
# ══════════════════════════════════════════════════════════════
# Stack: Bedrock + Aurora MySQL + Qdrant + S3 + Polly + Transcribe

# ── AWS Configuration ────────────────────────────────────────
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=bmsce-ai-erp-voice-bucket

# ── Database (Aurora MySQL) ──────────────────────────────────
# Endpoint from your RDS/Aurora console
AURORA_HOST=your-aurora-cluster.cluster-xxxx.ap-southeast-2.rds.amazonaws.com
AURORA_PORT=3306
AURORA_USER=erp_admin
AURORA_PASSWORD=your_secure_password_here
AURORA_DATABASE=erp_assistant
DB_POOL_SIZE=5
DB_POOL_RECYCLE=3600

# ── Amazon Bedrock (LLM) ────────────────────────────────────
BEDROCK_REGION=ap-southeast-2
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MAX_TOKENS=1024

# ── Amazon Bedrock (Embeddings — Titan) ─────────────────────
BEDROCK_EMBEDDING_REGION=ap-southeast-2
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSION=1024

# ── Qdrant (Vector DB for RAG) ──────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=erp_documents

# ── RAG Settings ─────────────────────────────────────────────
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5

# ── Amazon Polly (TTS) ──────────────────────────────────────
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=neural
